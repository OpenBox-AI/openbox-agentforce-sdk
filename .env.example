# OpenBox organisation API key (Organization > API Keys in the OpenBox dashboard). Required.
OPENBOX_ORG_API_KEY=obx_key_...
OPENBOX_PLATFORM_API_URL=https://api.openbox.ai

# The name your agent gets in OpenBox. provision.mjs finds or creates the agent by this name.
OPENBOX_AGENT_NAME=My Agentforce Agent

# Optional: OpenBox Core of another environment. When set, run
# scripts/salesforce/configure-endpoints.mjs to point the org at it (deploy.mjs does this for you).
# Leave unset for OpenBox production.
OPENBOX_CORE_URL=

# Written by scripts/salesforce/workload-certificate.mjs: the public half of the Salesforce
# certificate that signs the agent's workload assertions. Public, but do not edit by hand.
OPENBOX_WORKLOAD_PUBLIC_JWK=

# Written by scripts/openbox/provision.mjs when it registers the agent. Do not edit by hand.
OPENBOX_AGENT_ID=
OPENBOX_AGENT_API_KEY=

# Written by scripts/salesforce/create-agent-user.mjs.
SF_AGENT_USERNAME=

# Optional default org alias for the scripts (otherwise pass --target-org).
SF_TARGET_ORG=my-org

# A second org keeps its own copy of this file: run the scripts with OPENBOX_ENV_FILE=.env.<name>
# (and OPENBOX_AGENT_NAME="..." for provision.mjs) so this file is never touched.
